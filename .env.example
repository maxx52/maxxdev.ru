# Copy to .env on the VDS. Do not commit .env or expose it through nginx.
SITE_URL=https://maxxdev.ru
HOST=127.0.0.1
PORT=3001
CONTACT_DATA_DIR=./var/contact-outbox

# Destination for incoming requests; replace before starting the backend.
MAIL_TO=you@example.com
# For the 1Gb relay use a sender mailbox registered with the hosting provider.
MAIL_FROM=website@example.com
SMTP_HOST=robots.1gb.ru
SMTP_PORT=25
SMTP_SECURE=false
# The 1Gb relay normally needs no authentication from the VDS network.
# For an external SMTP server fill these and change host/port/secure as required.
SMTP_USER=
SMTP_PASSWORD=

# Values are server-only: BotFather token and the destination's numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
