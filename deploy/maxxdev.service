[Unit]
Description=MaxxDev website and contact delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maxxdev
Group=maxxdev
WorkingDirectory=/var/www/maxxdev.ru
EnvironmentFile=/var/www/maxxdev.ru/.env
ExecStart=/usr/bin/node /var/www/maxxdev.ru/server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/maxxdev.ru/var
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
